# ==========================================
# CREATIVEMU ACADEMY - ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env.local for local development.
# DO NOT commit actual secrets or production keys to version control.

# ------------------------------------------
# Database Connection (Prisma / Direct DB)
# ------------------------------------------
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
# Public URL & Anon/Publishable Key (safe for browser)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY"

# Service Role Key (SERVER ONLY - Bypasses RLS - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SERVICE_ROLE_KEY"

# ------------------------------------------
# Application Domain & Site Metadata
# ------------------------------------------
# Canonical production URL (e.g. https://creativemuacademy.com)
NEXT_PUBLIC_APP_URL="https://creativemuacademy.com"

# ------------------------------------------
# Admin & Contact Integrations
# ------------------------------------------
# WhatsApp Admin Contact Number (international format without +)
NEXT_PUBLIC_ADMIN_WA_NUMBER="6285177114036"

# ------------------------------------------
# Analytics & Tracking (Optional)
# ------------------------------------------
# Google Analytics Measurement ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=""

# Meta (Facebook) Pixel ID (e.g., 1234567890)
NEXT_PUBLIC_META_PIXEL_ID=""
